{
  "name": "ieces-report",
  "version": "1.0.0",
  "description": "IECES Admin Report App",
  "author": "BuzzJay",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.5",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.6",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "build": {
    "appId": "com.ieces.report",
    "productName": "IECES Report",
    "icon": "public/prieces",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/prieces.ico",
      "public/prieces.icns"
    ],
    "extraResources": [],
    "win": {
      "icon": "public/prieces.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "public/prieces.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}